{
  "name": "scylla",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm run prebuild && vite",
    "build": "pnpm run prebuild && pnpm run typecheck && vite build",
    "typecheck": "tsc -b && svelte-check --tsconfig ./tsconfig.app.json --threshold error",
    "prebuild": "pnpm run gen-proto && (pnpm run extract || true) && pnpm run compile",
    "gen-proto": "node scripts/gen-proto.mjs",
    "extract": "lingui extract --clean",
    "compile": "lingui compile --typescript",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --max-warnings 0",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "depcruise:cycles": "depcruise src --config .dependency-cruiser.cjs --output-type json | node scripts/check-module-cycles.mjs",
    "i18n:collisions": "node scripts/check-catalog-collisions.mjs",
    "depcruise:graph": "depcruise src --config .dependency-cruiser.cjs --output-type archi | dot -T svg > dependency-graph.svg",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@lingui/core": "^5.4.1",
    "@lucide/svelte": "^1.46.0",
    "@protobuf-ts/grpcweb-transport": "^2.11.1",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "@tanstack/query-core": "5.103.1",
    "@tanstack/svelte-query": "^6.2.1",
    "@tanstack/svelte-table": "^9.2.4",
    "@tanstack/table-core": "9.2.4",
    "@xyflow/svelte": "^1.6.6",
    "bits-ui": "^2.19.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sv-router": "^0.19.0",
    "svelte": "^5.57.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.33.0",
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.4.1",
    "@lingui/vite-plugin": "^5.4.1",
    "@protobuf-ts/plugin": "^2.11.1",
    "@protobuf-ts/protoc": "^2.11.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^16.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "7.1.11",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.0"
  }
}
