  "query": "\n                SELECT id, project_id, name,\n                       nodes AS \"nodes: Json<Vec<PipelineNode>>\",\n                       created_at, updated_at\n                FROM pipelines\n                WHERE project_id = $1\n                ORDER BY created_at DESC\n                LIMIT $2 OFFSET $3\n                ",
