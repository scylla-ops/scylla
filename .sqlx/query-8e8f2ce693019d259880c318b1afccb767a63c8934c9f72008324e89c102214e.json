  "query": "\n            SELECT id, pipeline_id, status,\n                   node_executions AS \"node_executions: Json<Vec<JobNode>>\",\n                   agent_app_id,\n                   created_at, updated_at, started_at, finished_at\n            FROM jobs\n            WHERE status = $1 AND agent_app_id IS NULL\n            ORDER BY created_at ASC\n            ",
