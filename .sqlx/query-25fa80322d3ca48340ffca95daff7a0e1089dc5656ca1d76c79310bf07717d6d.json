  "query": "\n            SELECT principal_id, MAX(created_at) AS \"granted_at!\" FROM grants\n            WHERE principal_kind = 'user' AND scope_kind = 'project' AND scope_id = $1\n            GROUP BY principal_id\n            ORDER BY \"granted_at!\" DESC\n            LIMIT $2 OFFSET $3\n            ",
