{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT t.id, t.token, t.app_id, t.secret_id, t.created_at, t.expires_at\n            FROM app_tokens t\n            JOIN app_secrets s ON s.id = t.secret_id AND s.enabled = TRUE\n            JOIN apps a ON a.id = t.app_id AND a.is_active = TRUE\n            WHERE t.token = $1\n            ",
