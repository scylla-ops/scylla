  "query": "\n            SELECT id, job_id, node_id, stream, line, timestamp, created_at\n            FROM job_logs\n            WHERE job_id = $1\n              AND ($2::text IS NULL OR node_id = $2)\n            ORDER BY timestamp ASC, id ASC\n            LIMIT $3 OFFSET $4\n            ",
