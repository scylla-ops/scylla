  "query": "SELECT r.id, r.key, r.name, r.description, r.scope_kind, r.owner_org_id, r.builtin, COALESCE(ARRAY_AGG(rp.permission) FILTER (WHERE rp.permission IS NOT NULL), ARRAY[]::text[]) AS \"permissions!\" FROM roles r LEFT JOIN role_permissions rp ON rp.role_id = r.id WHERE r.id = $1 GROUP BY r.id",
