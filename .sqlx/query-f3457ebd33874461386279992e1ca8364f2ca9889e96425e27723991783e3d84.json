{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT w.app_id, w.last_seen, w.created_at, w.agent_version, w.host_os,\n                   w.host_arch, w.hostname, w.cpu_count, w.total_memory_mb,\n                   w.host_reported_at\n            FROM agents w\n            JOIN apps a ON a.id = w.app_id\n            WHERE a.organization_id = $1\n            ORDER BY w.created_at DESC\n            ",
