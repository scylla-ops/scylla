{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, name, description, organization_id, is_active, created_at, updated_at\n            FROM projects\n            WHERE (NOT $3 OR is_active)\n              AND ($4::text IS NULL OR organization_id = $4)\n            ORDER BY created_at DESC\n            LIMIT $1 OFFSET $2\n            ",
