// scylla — Cedar schema (V1). Validated against policies at startup.
//
// Entities form the tenancy hierarchy Pipeline ∈ Project ∈ Organization and
// Job ∈ Pipeline. A User carries its role memberships (entity parents) plus
// ABAC attributes listing the orgs/projects it belongs to. Actions are
// fine-grained (one per use-case operation) so `appliesTo` pins the resource
// type and policies stay readable.

namespace Scylla {
    entity Role;
    entity Service;
    entity System;

    // Machine principal (agent / automation) owned by an organization. As a
    // principal it carries scoped grants like a User (no ABAC attributes); as a
    // resource it lives under its org, so org-admins manage it via the hierarchy.
    entity App in [Organization];

    entity Organization;
    entity Project in [Organization];
    entity Pipeline in [Project];
    entity Job in [Pipeline];

    entity User in [Role] {
        "memberOrgs": Set<Organization>,
        "memberProjects": Set<Project>,
    };

    // ── System-scoped (admin / service) ────────────────────────────────
    action "createUser", "listUsers",
           "createOrganization", "listOrganizations",
           "listProjects", "listPipelines",
           "createJob", "listJobs",
           "managePolicies", "manageRoles"
        appliesTo { principal: [User, Service], resource: [System] };

    // Grant management is scope-aware: a system admin manages any grant
    // (resource System); an org/project admin manages grants within their scope
    // (resource Organization / Project). Cedar `resource in ?resource` on the
    // role template confines each admin to its own subtree, so an org admin
    // cannot touch another org's grants (anti-escalation).
    action "manageGrants"
        appliesTo { principal: [User, Service], resource: [System, Organization, Project] };

    // ── User-targeted ──────────────────────────────────────────────────
    action "readUser", "updateUser", "deleteUser",
           "listUserOrganizations", "listUserProjects"
        appliesTo { principal: [User, Service], resource: [User] };

    // ── Organization-targeted ──────────────────────────────────────────
    action "readOrganization", "updateOrganization", "deleteOrganization",
           "listOrganizationMembers", "addOrganizationMember", "removeOrganizationMember",
           "createProject", "createApp", "createWorker",
           "listProjectsByOrganization", "listPipelinesByOrganization", "listJobsByOrganization",
           "listAppsByOrganization", "listWorkers"
        appliesTo { principal: [User, Service], resource: [Organization] };

    // ── Project-targeted ───────────────────────────────────────────────
    action "readProject", "updateProject", "deleteProject",
           "listProjectMembers", "addProjectMember", "removeProjectMember",
           "createPipeline",
           "listPipelinesByProject", "listJobsByProject"
        appliesTo { principal: [User, Service], resource: [Project] };

    // ── Pipeline-targeted ──────────────────────────────────────────────
    action "updatePipeline", "deletePipeline", "runPipeline",
           "listJobsByPipeline"
        appliesTo { principal: [User, Service], resource: [Pipeline] };
    // Also grantable to worker Apps (read the pipeline, execute its jobs).
    action "readPipeline", "executeJob"
        appliesTo { principal: [User, Service, App], resource: [Pipeline] };

    // ── Job-targeted ───────────────────────────────────────────────────
    action "readJob", "writeJob", "deleteJob", "readJobLogs", "writeJobLogs"
        appliesTo { principal: [User, Service], resource: [Job] };
    // Job status / log writes are also grantable to worker Apps.
    action "writeJobStatus", "writeJobLog"
        appliesTo { principal: [User, Service, App], resource: [Job] };

    // ── App-targeted (manage a specific app within its org) ─────────────
    // A worker is a specialized app, so worker introspection/management also
    // targets the App resource (worker_app_id == app id).
    action "readApp", "deleteApp",
           "readWorker", "readWorkerStats", "deleteWorker"
        appliesTo { principal: [User, Service], resource: [App] };
}
